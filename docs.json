{
    "$schema": "https://mintlify.com/docs.json",
    "theme": "willow",
    "name": "AzarineGuard",
    "colors": {
        "primary": "#3F00FF",
        "light": "#0096FF",
        "dark": "#3F00FF"
    },
    "appearance": {
        "default": "dark",
        "strict": true
    },
    "favicon": "/favicon.svg",
    "navigation": {
        "tabs": [{
                "tab": "Guides",
                "groups": [{
                        "group": "First Steps",
                        "pages": [
                            "index",
                            "central-manual",
                            "discord-manual",
                            "ads-manual"
                        ]
                    },
                    {
                        "group": "Customization",
                        "pages": [
                            "advanced/macros"
                        ]
                    },
                    {
                        "group": "Legal Stuff",
                        "pages": [
                            "legal/tos",
                            "legal/privacy"
                        ]
                    }
                ]
            },
            {
                "tab": "API",
                "groups": [{
                    "group": "First Steps",
                    "pages": [
                        "api-reference/introduction"
                    ]
                }]
            }
        ],
        "global": {
            "anchors": [{
                    "anchor": "Status Page",
                    "href": "https://status.azguard.my.id",
                    "icon": "chart-pie"
                },
                {
                    "anchor": "User Portal",
                    "href": "https://azguard.my.id/portal",
                    "icon": "door-open"
                }
            ]
        }
    },
    "logo": {
        "light": "/logo/light.svg",
        "dark": "/logo/dark.svg",
        "href": "https://azguard.my.id"
    },
    "navbar": {
        "links": [{
            "label": "Support",
            "href": "https://discord.gg/skYCpZYuxa"
        }],
        "primary": {
            "type": "button",
            "label": "Dashboard",
            "href": "https://central.azguard.my.id"
        }
    },
    "contextual": {
        "options": [
            "copy",
            "view",
            "chatgpt",
            "claude",
            "perplexity",
            "mcp",
            "cursor",
            "vscode"
        ]
    },
    "footer": {
        "socials": {
            "discord": "https://discord.azguard.my.id",
            "github": "https://github.com/SdevSS/"
        }
    }
}